{
  "name": "vibegate",
  "version": "0.3.0",
  "description": "VibeGate is the local readiness gate that green-lights vibe-coded apps for non-dev shippers — one command, bilingual traffic-light verdict on clean-env run + readiness + license.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "vibegate": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "VERSION"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/scan.test.ts tests/run.test.ts",
    "prepublishOnly": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "demo:render": "vhs docs/demo.tape"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperMarioYL/vibegate.git"
  },
  "homepage": "https://github.com/SuperMarioYL/vibegate",
  "bugs": {
    "url": "https://github.com/SuperMarioYL/vibegate/issues"
  },
  "keywords": [
    "vibe-coding",
    "ship-readiness",
    "license-scan",
    "readiness-check",
    "non-dev",
    "cli",
    "mini-program"
  ],
  "author": "SuperMarioYL",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "consola": "^3.2.2",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "ajv": "^8.17.1",
    "yaml": "^2.6.1",
    "license-checker": "^25.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/license-checker": "^25.0.4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
